## 🔄 Integration with Frontend

### Frontend flow (learner.js)

```javascript
class LearnerPortal {
  async startAssessment(material_id) {
    // STEP 2
    const result = await api.request('POST', '/assessments/create', {
      learner_id: this.learner.id,
      material_id: material_id,
      num_questions: 5
    })
    
    this.assessment_id = result.assessment_id
    this.questions = result.questions
    this.current_question_index = 0
    this.displayQuestion()
  }
  
  displayQuestion() {
    const q = this.questions[this.current_question_index]
    // Show question to learner
    showQuestion({
      question_id: q.question_id,
      question: q.question,
      type: q.type,
      difficulty: q.difficulty
    })
  }
  
  async submitAnswer(answer_text) {
    // STEP 3-4
    const result = await api.request('POST', `/assessments/${this.assessment_id}/answers/submit`, {
      question_id: this.questions[this.current_question_index].question_id,
      answer_text: answer_text
    })
    
    showSuccess(`Answer saved (${result.progress})`)
    
    this.current_question_index++
    if (this.current_question_index < this.questions.length) {
      this.displayQuestion()
    } else {
      this.showSubmitButton()  // All done, show submit button
    }
  }
  
  async submitForGrading() {
    // STEP 5
    const result = await api.request('POST', `/assessments/${this.assessment_id}/grade`)
    
    this.showResults(result)
  }
  
  showResults(result) {
    // STEP 7
    if (result.passed) {
      showSuccess(`PASSED! Score: ${result.percentage}%`)
      showCertificate({
        token_id: result.certificate_token_id,
        tx_hash: result.certificate_tx_hash
      })
    } else {
      showError(`FAILED. Score: ${result.percentage}%`)
    }
    
    showDetailedFeedback(result.detailed_results)
  }
}
```

